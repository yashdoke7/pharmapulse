    "/api/replay/business-case": {
      "get": {
        "tags": [
          "replay"
        ],
        "summary": "Business Case",
        "description": "Our policy against a min/max policy, over the identical real days.\n\nSame data, same costs, same lead time, same review cadence, same protection\ninterval. The ONLY difference is that min/max sizes against the mean while\nwe size against the quantile the pharmacy's own cost ratio implies.\n\nThat makes the difference attributable to the thesis rather than to a\nhandicap given to the baseline.",
        "operationId": "business_case_api_replay_business_case_get",
        "parameters": [
          {
            "name": "start_date",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "2019-01-01",
              "title": "Start Date"
            }
          },
          {
            "name": "end_date",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "2019-03-31",
              "title": "End Date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "title": "Response Business Case Api Replay Business Case Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
