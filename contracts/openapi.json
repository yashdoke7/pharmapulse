  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "OrderCommit": {
        "properties": {
          "series_id": {
            "type": "string",
            "title": "Series Id"
          },
          "recommended": {
            "type": "integer",
            "title": "Recommended"
          },
          "accepted": {
            "type": "integer",
            "title": "Accepted"
          },
          "service_level": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Service Level"
          },
          "reason": {
            "type": "string",
            "title": "Reason",
            "default": ""
          },
          "actor": {
            "type": "string",
            "title": "Actor",
            "default": "demo"
          }
        },
        "type": "object",
        "required": [
          "series_id",
          "recommended",
          "accepted"
        ],
        "title": "OrderCommit"
      },
      "RecommendRequest": {
        "properties": {
          "series_id": {
            "type": "string",
            "title": "Series Id",
            "default": "N02BE"
          },
          "service_level": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 0.999,
                "minimum": 0.01
              },
              {
                "type": "null"
              }
            ],
            "title": "Service Level"
          },
          "lead_time_days": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 90.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Lead Time Days"
          },
          "stock_on_hand": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Stock On Hand"
          },
          "pack_size": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 1000.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Pack Size"
          },
          "unit_cost": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit Cost"
          },
          "unit_margin": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit Margin"
          },
          "holding_cost_rate": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 5.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Holding Cost Rate"
          },
          "expiry_risk_rate": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Expiry Risk Rate"
          },
          "review_period_days": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 90.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Review Period Days"
          }
        },
        "type": "object",
        "title": "RecommendRequest"
      },
      "StartRequest": {
        "properties": {
          "from": {
            "type": "string",
            "title": "From",
            "default": "2019-01-01"
          },
          "to": {
            "type": "string",
            "title": "To",
            "default": "2019-03-31"
          },
          "policy": {
            "type": "string",
            "title": "Policy",
            "default": "pharmapulse"
          }
        },
        "type": "object",
        "title": "StartRequest"
      },
      "TickRequest": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "steps": {
            "type": "integer",
            "maximum": 30.0,
            "minimum": 1.0,
            "title": "Steps",
            "default": 1
          }
        },
        "type": "object",
        "required": [
          "session_id"
        ],
        "title": "TickRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}