FROM node:20-alpine

WORKDIR /app

# Dependency layer first so a source edit does not reinstall node_modules.
COPY web/package*.json ./
RUN npm ci || npm install

COPY web/ ./
# Fixtures live outside web/ and are imported by the fixture-mode client.
COPY contracts/fixtures /contracts/fixtures

EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]

# For the production build instead:
#   RUN npm run build
#   CMD ["npx", "vite", "preview", "--host", "0.0.0.0", "--port", "5173"]
