FROM python:3.11-slim

# Build deps for prophet/cmdstanpy and lightgbm. Removed after the pip install.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential git curl libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY pipelines/ ./pipelines/
COPY core/ ./core/
COPY decision/ ./decision/
COPY api/ ./api/
COPY scripts/ ./scripts/
COPY contracts/ ./contracts/
COPY pyproject.toml Makefile ./

# Non-root. The data volume is mounted at runtime and must be writable by this uid.
RUN useradd -m -u 10001 pulse && chown -R pulse:pulse /app
USER pulse

ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1

EXPOSE 8000
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
